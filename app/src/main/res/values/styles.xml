<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===== 排版 ===== -->
    <style name="Text.Headline" parent="">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.Subtitle" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>

    <style name="Text.Section" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.Label" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>

    <style name="Text.Body" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="Text.Mono" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <!-- ===== 容器 ===== -->
    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layout_marginTop">@dimen/space_m</item>
        <item name="android:padding">@dimen/space_l</item>
        <item name="android:background">@drawable/bg_card</item>
    </style>

    <!-- 下拉框外壳：负责圆角描边，里面的 Spinner 透明叠在上面 -->
    <style name="Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/field_height</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:background">@drawable/bg_field</item>
    </style>

    <style name="Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Button.Primary.Base" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Button.Primary" parent="Button.Primary.Base" />

    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">@dimen/space_m</item>
        <item name="android:layout_marginBottom">@dimen/space_m</item>
        <item name="android:background">@color/divider</item>
    </style>

</resources>
