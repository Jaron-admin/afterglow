<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/recordingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recordings_title"
            android:textColor="@color/on_surface"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/recordingNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/recordings_notice"
            android:textColor="@color/on_surface_variant"
            android:textSize="13sp" />

        <HorizontalScrollView
            android:id="@+id/recordingFilters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none" />

        <FrameLayout
            android:id="@+id/recordingStorageBox"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            android:background="@drawable/bg_field">

            <TextView
                android:layout_width="24dp"
                android:layout_height="match_parent"
                android:layout_gravity="right|center_vertical"
                android:layout_marginRight="8dp"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="▾"
                android:textColor="@color/on_surface_variant"
                android:textSize="15sp" />

            <Spinner
                android:id="@+id/recordingStorage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:popupBackground="@color/surface"
                android:spinnerMode="dropdown" />
        </FrameLayout>

        <TextView
            android:id="@+id/recordingSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/recordingList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@color/divider"
            android:dividerHeight="1dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingBottom="12dp" />

        <LinearLayout
            android:id="@+id/recordingEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_icon_well"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="@string/recordings_empty_mark"
                android:textColor="@color/primary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/recordingEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/recordings_empty_title"
                android:textColor="@color/on_surface"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/recordingEmptyBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/recordings_empty_body"
                android:textColor="@color/on_surface_variant"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <HorizontalScrollView
        android:id="@+id/recordingSelection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:fillViewport="true"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingTop="8dp"
            android:paddingRight="12dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/recordingSelectionCount"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:paddingRight="8dp"
                android:textColor="@color/on_surface"
                android:textSize="14sp" />

            <Button
                android:id="@+id/recordingExport"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_btn_primary"
                android:minWidth="72dp"
                android:text="@string/recording_export"
                android:textAllCaps="false"
                android:textColor="@color/on_primary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/recordingShare"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginLeft="8dp"
                android:background="@drawable/bg_field"
                android:minWidth="72dp"
                android:text="@string/recording_share"
                android:textAllCaps="false"
                android:textColor="@color/secondary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/recordingDelete"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginLeft="8dp"
                android:background="@drawable/bg_field"
                android:minWidth="72dp"
                android:text="@string/recording_delete"
                android:textAllCaps="false"
                android:textColor="@color/danger"
                android:textSize="14sp" />

            <Button
                android:id="@+id/recordingCancel"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginLeft="8dp"
                android:background="@drawable/bg_field"
                android:minWidth="72dp"
                android:text="@string/recording_cancel"
                android:textAllCaps="false"
                android:textColor="@color/on_surface"
                android:textSize="14sp" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
